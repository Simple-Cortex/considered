{
  "$schema": "considered-runtime-manifest/v1",
  "version": "0.7.0",
  "description": "Authority for installed skill files. Everything listed here is included in the runtime skill package. Everything not listed is excluded.",
  "include": [
    "SKILL.md",
    "package.json",
    "README.md",
    "LICENSE",
    "bin/considered.mjs",
    "scripts/lib/rules.mjs",
    "scripts/wizard-plan.mjs",
    "scripts/lint-contract.mjs",
    "scripts/lint-source.mjs",
    "scripts/inventory.mjs",
    "scripts/roll.mjs",
    "scripts/gate.mjs",
    "scripts/validate-assets.mjs",
    "scripts/lint-render.mjs",
    "scripts/test.mjs",
    "scripts/eval.mjs",
    "scripts/check.mjs",
    "scripts/install.mjs",
    "scripts/prepack.mjs",
    "scripts/validate-skill.mjs",
    "assets/rules/*.json",
    "assets/decks/*.json",
    "assets/templates/*.md",
    "assets/templates/*.json",
    "references/*.md",
    "skills/*/SKILL.md",
    "runtime-manifest.json"
  ],
  "exclude": [
    "evals/",
    "tests/",
    "docs/",
    "crates/",
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "DEVLOG.md",
    "DEVLOG.raw.md",
    "CHANGELOG.md",
    ".github/",
    ".serena/",
    ".playwright-cli/",
    ".playwright-mcp/",
    ".qwen/",
    ".considered/",
    "agents/",
    "scripts/bump.mjs",
    "scripts/skill-doc.mjs",
    "scripts/sync-readme-skills.mjs",
    "scripts/agent-bridge.mjs",
    "scripts/collect.mjs",
    "scripts/judge.mjs",
    "scripts/eval-audit.mjs",
    "scripts/refresh-eval-index.mjs",
    "scripts/manifest.mjs",
    "scripts/mint.mjs",
    "scripts/extract.mjs",
    "scripts/extract-all.mjs",
    "scripts/audit.mjs",
    "scripts/audit-update.mjs",
    "scripts/considered-eval.mjs",
    "scripts/capture.mjs",
    "scripts/diagnose.mjs"
  ],
  "engine": {
    "node": {
      "entry": "bin/considered.mjs",
      "status": "supported"
    },
    "rust": {
      "binary": "considered-rs",
      "install": "cargo install --path crates/considered-cli",
      "status": "supported",
      "protocol_version": "1.0.0"
    }
  }
}
